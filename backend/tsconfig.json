{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@prisma/client": ["../node_modules/.prisma/client/index.d.ts"]
    },
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
