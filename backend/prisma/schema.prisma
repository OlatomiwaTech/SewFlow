generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  TAILOR
  STAFF
}

enum MeasurementUnit {
  CM
  INCH
}

enum MeasurementSetStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum OrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OrderStatus {
  NEW
  MEASURED
  CUTTING
  SEWING
  FITTING
  READY
  DELIVERED
  CANCELLED
  PENDING
  IN_PROGRESS
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  POS
  OTHER
}

enum MaterialCategory {
  FABRIC
  THREAD
  BUTTON
  ZIPPER
  LINING
  INTERFACING
  ELASTIC
  OTHER
}

enum MaterialUnit {
  YARD
  METER
  PIECE
  ROLL
  SPOOL
  PACK
  OTHER
}

enum MovementType {
  INITIAL_STOCK
  PURCHASE
  ADJUSTMENT
  USAGE
  RETURN
  WASTE
}

model Business {
  id        String    @id @default(uuid())
  name      String
  currency  String    @default("NGN")
  timezone  String    @default("Africa/Lagos")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users           User[]
  customers       Customer[]
  materials       Material[]
  orders          Order[]
  payments        Payment[]
  measurementSets MeasurementSet[]
  stockMovements  StockMovement[]

  @@index([createdAt])
  @@index([deletedAt])
}

model User {
  id           String    @id @default(uuid())
  businessId   String
  name         String
  email        String
  passwordHash String
  role         UserRole  @default(OWNER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, email])
  @@index([businessId])
  @@index([businessId, isActive])
  @@index([deletedAt])
}

model Customer {
  id         String    @id @default(uuid())
  businessId String
  firstName  String
  lastName   String?
  phone      String
  email      String?
  address    String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  measurementSets MeasurementSet[]
  orders          Order[]

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([businessId, lastName, firstName])
  @@index([businessId, email])
  @@index([deletedAt])
}

model MeasurementSet {
  id         String                 @id @default(uuid())
  businessId String
  customerId String
  orderId    String?
  version    Int                    @default(1)
  status     MeasurementSetStatus   @default(ACTIVE)
  notes      String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  deletedAt  DateTime?

  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order       Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  measurements Measurement[]

  @@unique([customerId, orderId, version])
  @@index([businessId])
  @@index([customerId])
  @@index([orderId])
  @@index([businessId, customerId])
  @@index([businessId, orderId])
  @@index([deletedAt])
}

model Measurement {
  id               String          @id @default(uuid())
  businessId       String
  measurementSetId String
  unit             MeasurementUnit @default(CM)

  neck             Decimal?        @db.Decimal(10, 2)
  shoulder         Decimal?        @db.Decimal(10, 2)
  chest            Decimal?        @db.Decimal(10, 2)
  waist            Decimal?        @db.Decimal(10, 2)
  hip              Decimal?        @db.Decimal(10, 2)
  sleeve           Decimal?        @db.Decimal(10, 2)
  shirtLength      Decimal?        @db.Decimal(10, 2)
  trouserLength    Decimal?        @db.Decimal(10, 2)
  thigh            Decimal?        @db.Decimal(10, 2)
  knee             Decimal?        @db.Decimal(10, 2)
  ankle            Decimal?        @db.Decimal(10, 2)

  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  measurementSet MeasurementSet @relation(fields: [measurementSetId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([measurementSetId])
  @@index([businessId, createdAt])
  @@index([deletedAt])
}

model Order {
  id            String        @id @default(uuid())
  businessId    String
  customerId    String
  garmentType   String
  description   String?
  quantity      Int           @default(1)

  totalAmount   Decimal       @db.Decimal(12, 2)
  depositAmount Decimal       @default(0) @db.Decimal(12, 2)

  status        OrderStatus   @default(NEW)
  priority      OrderPriority @default(MEDIUM)

  orderDate     DateTime      @default(now())
  expectedDate  DateTime?
  deliveredAt   DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments        Payment[]
  history         OrderHistory[]
  materials       OrderMaterial[]
  stockMovements  StockMovement[]
  measurementSets MeasurementSet[]

  @@index([businessId])
  @@index([customerId])
  @@index([businessId, customerId])
  @@index([businessId, status])
  @@index([businessId, orderDate])
  @@index([deletedAt])
}

model OrderHistory {
  id          String       @id @default(uuid())
  businessId  String
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  createdById String?
  createdAt   DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([orderId])
  @@index([orderId, createdAt])
}

model Payment {
  id            String        @id @default(uuid())
  businessId    String
  orderId       String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  reference     String?
  idempotencyKey String?      @db.VarChar(128)
  paymentDate   DateTime      @default(now())
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, idempotencyKey])
  @@index([businessId])
  @@index([orderId])
  @@index([businessId, orderId])
  @@index([businessId, paymentDate])
  @@index([idempotencyKey])
  @@index([deletedAt])
}

model Material {
  id                String           @id @default(uuid())
  businessId        String
  code              String
  sku               String?
  name              String
  description       String?
  category          MaterialCategory @default(FABRIC)
  unit              MaterialUnit     @default(YARD)
  currentQuantity   Decimal          @default(0) @db.Decimal(12, 2)
  minimumStockLevel Decimal          @default(0) @db.Decimal(12, 2)
  costPerUnit       Decimal          @default(0) @db.Decimal(12, 2)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  orderMaterials OrderMaterial[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([businessId, category])
  @@index([businessId, isActive])
  @@index([businessId, code])
  @@index([deletedAt])
}

model OrderMaterial {
  id              String       @id @default(uuid())
  businessId      String
  orderId         String
  materialId      String

  plannedQuantity Decimal      @default(0) @db.Decimal(12, 2)
  actualQuantity  Decimal      @default(0) @db.Decimal(12, 2)

  unit            MaterialUnit
  unitCost        Decimal      @db.Decimal(12, 2)
  totalCost       Decimal      @default(0) @db.Decimal(12, 2)

  notes           String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([orderId, materialId])
  @@index([businessId])
  @@index([orderId])
  @@index([materialId])
  @@index([orderId, materialId])
  @@index([deletedAt])
}

model StockMovement {
  id             String       @id @default(uuid())
  businessId     String
  materialId     String
  orderId        String?
  type           MovementType
  quantityChange Decimal      @db.Decimal(12, 2)
  quantityBefore Decimal      @db.Decimal(12, 2)
  quantityAfter  Decimal      @db.Decimal(12, 2)
  notes          String?
  createdById    String?
  createdAt      DateTime     @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([materialId])
  @@index([orderId])
  @@index([businessId, materialId, createdAt])
}
