generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  STAFF
}

enum MeasurementUnit {
  CM
  INCH
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

model Business {
  id        String   @id @default(uuid())
  name      String
  currency  String   @default("NGN")
  timezone  String   @default("Africa/Lagos")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  customers Customer[]

  @@index([createdAt])
}

model User {
  id           String   @id @default(uuid())
  businessId   String
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(OWNER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Customer {
  id         String   @id @default(uuid())
  businessId String
  firstName  String
  lastName   String?
  phone      String
  email      String?
  address    String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  measurements Measurement[]
  orders       Order[]

  @@index([businessId])
  @@index([businessId, phone])
  @@index([businessId, lastName, firstName])
}

model Measurement {
  id            String          @id @default(uuid())
  customerId    String
  unit          MeasurementUnit @default(CM)

  neck          Decimal?        @db.Decimal(10, 2)
  shoulder      Decimal?        @db.Decimal(10, 2)
  chest         Decimal?        @db.Decimal(10, 2)
  waist         Decimal?        @db.Decimal(10, 2)
  hip           Decimal?        @db.Decimal(10, 2)
  sleeve        Decimal?        @db.Decimal(10, 2)
  shirtLength   Decimal?        @db.Decimal(10, 2)
  trouserLength Decimal?        @db.Decimal(10, 2)
  thigh         Decimal?        @db.Decimal(10, 2)
  knee          Decimal?        @db.Decimal(10, 2)
  ankle         Decimal?        @db.Decimal(10, 2)

  notes         String?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, createdAt])
}

model Order {
  id            String      @id @default(uuid())
  customerId    String

  garmentType   String
  description   String?
  quantity      Int         @default(1)

  totalAmount   Decimal     @db.Decimal(12, 2)
  depositAmount Decimal     @default(0) @db.Decimal(12, 2)

  status        OrderStatus @default(PENDING)

  orderDate     DateTime    @default(now())
  expectedDate  DateTime?
  deliveredAt   DateTime?

  notes         String?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, status])
  @@index([customerId, createdAt])
}
